{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=CrmDatabase;User Id=sa;Password=${DB_PASSWORD};TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "Key": "${JWT_KEY}",
    "ExpiresMinutes": 60
  },
  "AllowedOrigins": "${ALLOWED_ORIGINS}",
  "SeedPassword": "${SEED_PASSWORD}"
}